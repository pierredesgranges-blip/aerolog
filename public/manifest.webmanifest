{
  "name": "AeroLog — carnet de vols",
  "short_name": "AeroLog",
  "description": "Carnet de vols passager et équipage, avec traces Flightradar24",
  "id": "/",
  "start_url": "/#/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "lang": "fr",
  "background_color": "#0b1220",
  "theme_color": "#0b1220",
  "categories": ["travel", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Nouveau vol", "url": "/#/new", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mes vols", "url": "/#/flights", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{
        "name": "track",
        "accept": [".kml", ".csv", "application/vnd.google-earth.kml+xml", "application/xml", "text/xml", "text/csv", "text/comma-separated-values", "application/octet-stream"]
      }]
    }
  }
}
